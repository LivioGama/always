[Unit]
Description=Always Overlay Companion Process
After=always-daemon.service
Requires=always-daemon.service

[Service]
Type=simple
ExecStart=/usr/local/bin/always-overlay
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=default.target