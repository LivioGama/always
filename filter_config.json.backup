{
  "hard_filter_starts_with": [
    "thank you",
    "thanks",
    "thank",
    "thankyou",
    "thank u",
    "thank you for",
    "thanks for",
    "thank for"
  ],
  "hard_filter_exact": [
    "you're welcome",
    "your welcome",
    "no problem",
    "no worries",
    "don't mention it",
    "my pleasure",
    "anytime",
    "happy to help",
