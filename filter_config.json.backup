  "hard_filter_regex": [
    "^thank.*for.*watching",
    "^thanks.*for.*watching",
    "^thank.*you.*for",
    ".*\\.com.*",
    ".*\\.org.*",
    ".*\\.net.*",
    ".*\\.io.*",
    ".*\\.dev.*",
    ".*\\.ai.*",
    ".*\\.app.*",
    ".*\\.co.*",
    "^[a-z]{1,3}$",
    "^[bcdfghjklmnpqrstvwxz]{3,}$",
    ".*[bcdfghjklmnpqrstvwxz]{4,}.*",
    "^\\w+\\.\\w+\\s+\\w+\\.\\w+",
    ".*\\b[bcdfghjklmnpqrstvwxz]{5,}\\b.*",
    ".*\\b\\w*[xzqj]\\w*\\.\\w+\\b.*",
    ".*\\b\\w{6,}\\.(com|org|net|io|dev|ai|app|co)\\b.*",
    "^[a-z]+\\.(com|org|net|io|dev|ai|app|co)$",
    ".*\\b[a-z]{3,}\\.[a-z]{3,}\\b.*",
    ".*[qxzj]{2,}.*",
    "^\\w+\\s+\\w+\\s+\\w+\\s+\\w+\\s+\\w+.*",
    ".*\\b[aeiou]{4,}\\b.*",
    ".*\\b[bcdfghjklmnpqrstvwxz]{6,}\\b.*",
    "^[^aeiou\\s]{4,}$",
    ".*\\b\\w*[xyz]\\w*[xyz]\\w*\\b.*",
    ".*[0-9]+\\.(com|org|net).*",
    ".*\\b\\w{10,}\\b.*",
    "^[a-z]+[0-9]+[a-z]*$"
  ]
}