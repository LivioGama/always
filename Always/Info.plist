<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.always</string>
    <key>CFBundleName</key>
    <string>Always</string>
    <key>CFBundleDisplayName</key>
    <string>Always</string>
    <key>CFBundleExecutable</key>
    <string>Always</string>
    <key>CFBundleIconFile</key>
    <string>AlwaysIcon</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <!--
      Regular foreground app: keep a Dock tile/running dot while still
      installing our own NSStatusItem from AppDelegate.
    -->
    <!--
      LSUIElement=true is REQUIRED to match setActivationPolicy(.accessory)
      in App.init(). Mismatching them is a confirmed Tahoe 26 trap: macOS
      treats the bundle as a Dock-bearing regular app at the LaunchServices
      level, then we partially override at runtime, and the result is a
      status item that gets created but never slotted into the menu bar
      (renders at screen origin 0,0 instead of top-right). Keep these
      two declarations consistent.
    -->
    <key>LSUIElement</key>
    <true/>
    <!--
      Even as a regular app, keep automatic/sudden termination disabled
      so the background voice daemon survives idle periods and macOS
      doesn't reap the GUI when no windows are open.
    -->
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>NSAccessibilityUsageDescription</key>
    <string>Always needs accessibility access to position the voice indicator near your active text cursor.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Always needs accessibility access to position the voice indicator near your active text field.</string>
    <!--
      Sparkle auto-update settings.

      `SUFeedURL`         — appcast XML emitted by .github/workflows/release.yml.
      `SUPublicEDKey`     — base64 EdDSA public key. Rotate per docs/RELEASE.md;
                            replace with the matching public half each rotation.
                            Placeholder must be replaced before the first
                            signed release reaches users.
      `SUEnableAutomaticChecks` — enabled; user can disable via Settings.
      `SUScheduledCheckInterval` — 86400s = once per day.
    -->
    <key>SUFeedURL</key>
    <string>https://github.com/rtk-ai/always/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>REPLACE_WITH_BASE64_EDDSA_PUBLIC_KEY</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
